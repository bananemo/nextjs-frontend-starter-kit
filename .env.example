# Copy to `.env.local` and fill in. All variables are validated at build time
# by `src/lib/env.ts` — an unknown or malformed value fails the build.
#
# Every variable below is optional; the app runs with none of them set.

# Canonical origin. Used for metadataBase, canonical links, sitemap and robots.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Analytics. No provider is wired by default — see src/lib/analytics/README
# notes in the project README. Add whichever keys your provider needs.
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=

# Observability. No provider is wired by default; these are stubbed for the
# Sentry setup described in the README.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=
